		'url' => tl_seo_public_base() . '/',
		'telephone' => tl_seo_phone(),
		'image' => tl_seo_logo_url(),
		'logo' => tl_seo_logo_url(),
		'description' => 'Mobile car wash in Abu Dhabi. Turbo Luxury cleans cars at homes, villas, and offices. Open 24 hours.',
		'address' => array(
