<?php
if (!defined('ABSPATH')) { return; }

function tl_seo_public_base() {
	return 'https://turboluxurycarwash.ae';
}

function tl_seo_path($path) {
	$path = '/' . ltrim((string) $path, '/');
	if ($path !== '/') {
		$path = rtrim($path, '/') . '/';
	}
	return tl_seo_public_base() . ($path === '/' ? '/' : $path);
}

function tl_seo_gmb() {
	return 'https://www.google.com/maps/place/Turbo+Luxury+Car+Wash/@24.4018311,54.5026328,17z/data=!3m1!4b1!4m6!3m5!1s0x3e5e41528ef19723:0xf0cc3e64e15b4089!8m2!3d24.4018311!4d54.5026328!16s%2Fg%2F11lm9v8bx8';
}

function tl_seo_phone() {
	return '+971569892095';
}

function tl_seo_wa() {
	return 'https://wa.me/971569892095';
}

function tl_seo_logo_url() {
	$id = (int) get_theme_mod('custom_logo');
	$url = $id ? wp_get_attachment_url($id) : '';
	if ($url) {
		return $url;
	}
	return content_url('uploads/2026/09/turbo-luxury-car-wash-logo.png');
}

function tl_seo_image_url($id) {
	$id = (int) $id;
	if (!$id) {
		return tl_seo_logo_url();
	}
	$url = wp_get_attachment_image_url($id, 'full');
	return $url ? $url : tl_seo_logo_url();
}

function tl_seo_org_id() {
	return tl_seo_public_base() . '/#organization';
}

function tl_seo_website_id() {
	return tl_seo_public_base() . '/#website';
}

function tl_seo_jsonld($graph) {
	$payload = array(
		'@context' => 'https://schema.org',
		'@graph' => $graph,
	);
	$json = wp_json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
	return '<script type="application/ld+json">' . $json . '</script>';
}

function tl_seo_org_node() {
	return array(
		'@type' => array('AutoWash', 'LocalBusiness', 'Organization'),
		'@id' => tl_seo_org_id(),
		'name' => 'Turbo Luxury Car Wash',
