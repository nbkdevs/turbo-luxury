function tl_seo_build_graph($id, $cfg) {
	$url = tl_seo_path($cfg['path']);
	$img = (int) $cfg['image'];
	$graph = array(tl_seo_org_node(), tl_seo_website_node());

	switch ($cfg['type']) {
		case 'home':
			$graph[] = tl_seo_webpage_node($url, $cfg['title'], $cfg['desc'], $img, array('@type' => array('WebPage', 'CollectionPage')));
			$graph[] = tl_seo_breadcrumb(array(array('name' => 'Home', 'url' => $url)));
			break;
		case 'book':
			$graph[] = tl_seo_webpage_node($url, $cfg['title'], $cfg['desc'], $img, array('@type' => array('WebPage', 'ContactPage')));
			$graph[] = tl_seo_breadcrumb(array(
				array('name' => 'Home', 'url' => tl_seo_path('/')),
				array('name' => 'Book', 'url' => $url),
			));
			break;
		case 'hub_services':
		case 'hub_areas':
		case 'hub_cases':
			$graph[] = tl_seo_webpage_node($url, $cfg['title'], $cfg['desc'], $img, array('@type' => array('WebPage', 'CollectionPage')));
			$hub_name = $cfg['type'] === 'hub_services' ? 'Services' : ($cfg['type'] === 'hub_areas' ? 'Areas' : 'Case Studies');
			$graph[] = tl_seo_breadcrumb(array(
				array('name' => 'Home', 'url' => tl_seo_path('/')),
				array('name' => $hub_name, 'url' => $url),
			));
			break;
		case 'location':
			$graph[] = tl_seo_webpage_node($url, $cfg['title'], $cfg['desc'], $img);
			$graph[] = tl_seo_service_node($url, 'Mobile Car Wash in ' . $cfg['area'], $cfg['desc'], $cfg['area'], $img);
			$graph[] = tl_seo_breadcrumb(array(
				array('name' => 'Home', 'url' => tl_seo_path('/')),
				array('name' => 'Areas', 'url' => tl_seo_path('/areas/')),
				array('name' => $cfg['area'], 'url' => $url),
			));
			break;
		case 'service':
			$graph[] = tl_seo_webpage_node($url, $cfg['title'], $cfg['desc'], $img);
			$graph[] = tl_seo_service_node($url, $cfg['service_name'] . ' in Abu Dhabi', $cfg['desc'], 'Abu Dhabi', $img);
			$graph[] = tl_seo_breadcrumb(array(
				array('name' => 'Home', 'url' => tl_seo_path('/')),
				array('name' => 'Services', 'url' => tl_seo_path('/services/')),
				array('name' => $cfg['service_name'], 'url' => $url),
			));
			break;
		case 'case':
			$graph[] = tl_seo_webpage_node($url, $cfg['title'], $cfg['desc'], $img);
			$graph[] = array(
				'@type' => 'Article',
				'@id' => $url . '#article',
				'headline' => get_the_title($id),
				'description' => $cfg['desc'],
				'image' => tl_seo_image_url($img),
				'author' => array('@id' => tl_seo_org_id()),
				'publisher' => array('@id' => tl_seo_org_id()),
				'mainEntityOfPage' => array('@id' => $url . '#webpage'),
				'about' => $cfg['about'],
				'inLanguage' => 'en-AE',
			);
			$graph[] = tl_seo_breadcrumb(array(
				array('name' => 'Home', 'url' => tl_seo_path('/')),
				array('name' => 'Case Studies', 'url' => tl_seo_path('/case-studies/')),
				array('name' => get_the_title($id), 'url' => $url),
			));
			break;
		case 'blog':
			$graph[] = tl_seo_webpage_node($url, $cfg['title'], $cfg['desc'], $img, array('@type' => array('WebPage', 'CollectionPage', 'Blog')));
			$graph[] = tl_seo_breadcrumb(array(
				array('name' => 'Home', 'url' => tl_seo_path('/')),
				array('name' => 'Blog', 'url' => $url),
			));
			break;
	}

	return $graph;
}

function tl_seo_apply_all() {
	$pages = tl_seo_pages_config();
	$results = array();
	foreach ($pages as $id => $cfg) {
		$post = get_post($id);
		if (!$post) {
			$results[$id] = 'missing';
			continue;
		}
		$graph = tl_seo_build_graph($id, $cfg);
		tl_seo_set_hfc($id, tl_seo_jsonld($graph));
		tl_seo_set_rankmath($id, $cfg['title'], $cfg['desc'], $cfg['focus']);
		$thumb_ok = tl_seo_set_featured($id, (int) $cfg['image']);
		$results[$id] = array(
			'slug' => $post->post_name,
			'title_len' => strlen($cfg['title']),
			'desc_len' => strlen($cfg['desc']),
			'focus' => $cfg['focus'],
			'thumb' => $thumb_ok ? (int) $cfg['image'] : 0,
			'hfc' => !empty(get_post_meta($id, '_auhfc', true)),
		);
	}

	return array(
		'pages' => $results,
		'theme_schema' => tl_seo_strip_theme_schema(),
		'public_base' => tl_seo_public_base(),
		'plugin_active' => is_plugin_active('head-footer-code/head-footer-code.php'),
	);
}
