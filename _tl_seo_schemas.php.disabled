	);
}

function tl_seo_website_node() {
	return array(
		'@type' => 'WebSite',
		'@id' => tl_seo_website_id(),
		'url' => tl_seo_public_base() . '/',
		'name' => 'Turbo Luxury Car Wash',
		'publisher' => array('@id' => tl_seo_org_id()),
		'inLanguage' => 'en-AE',
	);
}

function tl_seo_webpage_node($url, $name, $desc, $image_id, $extra = array()) {
	$node = array(
		'@type' => 'WebPage',
		'@id' => $url . '#webpage',
		'url' => $url,
		'name' => $name,
		'description' => $desc,
		'isPartOf' => array('@id' => tl_seo_website_id()),
		'about' => array('@id' => tl_seo_org_id()),
		'inLanguage' => 'en-AE',
		'primaryImageOfPage' => array(
			'@type' => 'ImageObject',
			'url' => tl_seo_image_url($image_id),
		),
	);
	return array_merge($node, $extra);
}

function tl_seo_breadcrumb($items) {
	$elements = array();
	$pos = 1;
	foreach ($items as $item) {
		$elements[] = array(
			'@type' => 'ListItem',
			'position' => $pos++,
			'name' => $item['name'],
			'item' => $item['url'],
		);
	}
	return array(
		'@type' => 'BreadcrumbList',
		'@id' => $items[count($items) - 1]['url'] . '#breadcrumb',
		'itemListElement' => $elements,
	);
}

function tl_seo_service_node($url, $name, $desc, $area = 'Abu Dhabi', $image_id = 0) {
	$service = array(
		'@type' => 'Service',
		'@id' => $url . '#service',
		'name' => $name,
		'description' => $desc,
		'url' => $url,
		'provider' => array('@id' => tl_seo_org_id()),
		'areaServed' => array(
			'@type' => 'Place',
			'name' => $area,
		),
		'serviceType' => 'Mobile car wash',
		'availableChannel' => array(
			'@type' => 'ServiceChannel',
			'serviceUrl' => tl_seo_path('/visit/'),
			'servicePhone' => tl_seo_phone(),
		),
	);
	if ($image_id) {
		$service['image'] = tl_seo_image_url($image_id);
	}
	return $service;
}

function tl_seo_set_hfc($post_id, $head_html) {
	$data = array(
		'behavior' => 'append',
		'head' => $head_html,
		'body' => '',
		'footer' => '',
	);
	update_post_meta($post_id, '_auhfc', $data);
}

function tl_seo_set_rankmath($post_id, $title, $desc, $focus) {
	update_post_meta($post_id, 'rank_math_title', $title);
	update_post_meta($post_id, 'rank_math_description', $desc);
	update_post_meta($post_id, 'rank_math_focus_keyword', $focus);
	update_post_meta($post_id, 'rank_math_rich_snippet', 'off');
}

function tl_seo_set_featured($post_id, $image_id) {
	$image_id = (int) $image_id;
	if ($image_id > 0 && get_post($image_id)) {
		set_post_thumbnail($post_id, $image_id);
		return true;
	}
	return false;
}

function tl_seo_strip_theme_schema() {
	$file = WP_CONTENT_DIR . '/novamira-sandbox/turbo-luxury-theme.php';
	if (!file_exists($file)) {
		return 'missing';
	}
	$c = file_get_contents($file);
	if (strpos($c, 'TL_SEO_SCHEMA_DISABLED') !== false) {
		return 'already';
	}
	$needle = "echo '<script type=\"application/ld+json\">' . wp_json_encode(\$local, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . '</script>' . \"\\n\";";
	if (strpos($c, $needle) === false) {
		return 'not-found';
	}
	$new = str_replace($needle, "/* TL_SEO_SCHEMA_DISABLED */\n\t// JSON-LD now served from Head & Footer Code (_auhfc).", $c);
	file_put_contents($file, $new);
	return 'stripped';
}

